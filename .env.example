# Optional settings for docker compose. Copy to .env (never committed) and change what you need;
# every line can stay commented out.

# The Gmail/ directory of a Scriba checkout. Default: ../scriba/Gmail (a clone next to this repo).
# Tested against the revision in backend/SCRIBA_REVISION.
# SCRIBA_PATH=../scriba/Gmail

# on: the seeded users Alice and Bob get synthetic Gmail/Outlook mail and calendars, the intake
# worker turns that mail into runs, and approving an action executes it in the sandbox world.
# Off (default): Scriba's own seeded inbox, where nothing needs work.
# After changing it: docker compose up -d
# DESK_DEMO=on
# Keep it here rather than in front of one command: every docker compose command must see the
# same value, or compose recreates the api without it.

# Jira in the Desk (docs/jira/README.md). Off (default): the Desk does not mention Jira.
# With DESK_DEMO=on it runs on a synthetic Jira site: nothing real is read or changed.
# DESK_JIRA=on
# Real changes to a connected Jira site stay held unless BOTH of these are set:
# DESK_JIRA_WRITES=on
# DESK_JIRA_WRITES_AUTHORIZED_BY=<who switched it on>

# The API address the browser uses. Default: http://localhost:8000 (the api service).
# VITE_API_BASE_URL=http://localhost:8000

# Time zone for frontend-tests (some UI tests assert UTC+2 clock times).
# TZ=Asia/Beirut

# For `docker compose --profile test run --rm smoke`: a seeded user from Scriba's
# e2e/seeded_server.py. Test values for the local seeded backend only; never a real account.
# SMOKE_EMAIL=
# SMOKE_PASSWORD=
