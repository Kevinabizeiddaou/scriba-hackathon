# Secrets and local configuration: never committed.
.env
.env.*
!.env.example
*.pem
*.key
tokens/
token*.json
credentials*.json
client_secret*.json
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# Dependencies and build output
node_modules/
dist/
coverage/
.vite/

# Python (later backend stages)
__pycache__/
*.pyc
.venv/
.pytest_cache/

# A pinned Scriba checkout used as the local runtime lives OUTSIDE this
# repository; if someone places one here it must not be committed.
vendor/scriba/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test artifacts
playwright-report/
test-results/
smoke-report*.json

# Frontend: evaluation output. Day snapshots under eval-results/snapshots/ are committed.
frontend/eval-results/*
!frontend/eval-results/snapshots/
!frontend/eval-results/.gitkeep
*.tsbuildinfo
