{
  "name": "scriba-executive-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/require-docker.mjs && vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "node scripts/require-docker.mjs && vite preview --port 5173 --strictPort",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval.ts",
    "fixtures:export": "tsx scripts/export-fixtures.ts",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "contract:server": "tsx scripts/contract-server.ts",
    "dev:reference": "tsx scripts/dev-reference.ts",
    "dev:demo": "node scripts/require-docker.mjs && vite --mode demo"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@tanstack/react-query": "^5.59.19",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Scriba Executive Desk: the connected workspace, plus the mock contract and evaluation harness."
}
